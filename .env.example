# PostgreSQL Database Configuration for MLflow Tracking Server Backend Store
POSTGRES_USER=mlflow_user
POSTGRES_PASSWORD=mlflow_password
POSTGRES_DB=mlflow_db

# MLflow Tracking Server URI (Use http://localhost:5000 when running locally, or http://mlflow-server:5000 inside Docker network)
MLFLOW_TRACKING_URI=http://mlflow-server:5000

# API Service Configuration
APP_HOST=0.0.0.0
APP_PORT=8000

# Model Registry and Experiment Tracking Configuration
MODEL_NAME=production-model
MODEL_STAGE=Production
EXPERIMENT_NAME=churn-prediction
